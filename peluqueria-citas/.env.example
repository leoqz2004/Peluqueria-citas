# Referencia para variables de entorno. Spring Boot no carga este .env automaticamente.
# Configurar las variables en PowerShell o en VS Code antes de ejecutar Maven.
# No subir valores reales de contrasenas.
SPRING_PROFILES_ACTIVE=sqlserver
DB_URL=jdbc:sqlserver://localhost;instanceName=SQLEXPRESS;databaseName=peluqueria_citas;encrypt=true;trustServerCertificate=true
DB_USER=app_citas
DB_PASSWORD=cambiar_esta_clave
# Primer administrador (clave de 12+ caracteres con mayuscula, minuscula y numero)
ADMIN_EMAIL=admin@tu-dominio.pe
ADMIN_PASSWORD=cambiar_esta_clave_Larga1
# true cuando se sirva por HTTPS
COOKIE_SECURE=false
# Opcional: acelera OWASP Dependency-Check
NVD_API_KEY=
# --- Operacion (scripts de mantenimiento y despliegue) ---
# DB_TYPE=sqlserver            # mysql | sqlserver (respaldos)
# DB_NAME=peluqueria_citas
# DB_SERVER=localhost\SQLEXPRESS   # solo scripts .ps1 con SQL Server
# BACKUP_DIR=C:\BellaEstilo\backups
# RETENCION_DIAS=14
# LOG_LEVEL=INFO               # DEBUG para diagnosticar
# MONITOREO_IPS=127.0.0.1/32,::1/128   # redes autorizadas para /actuator/prometheus
